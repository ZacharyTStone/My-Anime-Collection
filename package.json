{
  "name": "myanimecollection",
  "version": "1.0.1",
  "description": "A anime tracking application",
  "main": "Server/server.ts",
  "type": "module",
  "scripts": {
    "install-Client": "cd Client && npm install --include=dev",
    "install-Server": "npm install --include=dev",
    "build-Client": "cd Client && npm run build",
    "install-dependencies": "npm run install-Client && npm run install-Server",
    "heroku-postbuild": "npm run install-dependencies && npm run build-Client && tsc",
    "start-heroku-server": "node dist/server.js",
    "Server-local": "tsx watch Server/server.ts",
    "Client-local": "npm start --prefix Client",
    "test:server": "vitest run --config vitest.config.server.ts",
    "test:client": "npm --prefix Client run test:unit",
    "build:client": "npm --prefix Client run build",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:server && npm run test:client",
    "start": "concurrently \"npm run Server-local\" \"npm run Client-local\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/semver": "^7.7.1",
    "@types/supertest": "^7.2.1",
    "@types/validator": "^13.15.10",
    "mongodb-memory-server": "^11.2.0",
    "sass": "^1.87.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "bcryptjs": "^3.0.0",
    "concurrently": "^9.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.0.0",
    "express": "^5.2.1",
    "express-mongo-sanitize": "^2.1.0",
    "express-rate-limit": "^8.6.0",
    "google-auth-library": "^10.9.0",
    "helmet": "^8.0.0",
    "http-status-codes": "^2.1.4",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.0.0",
    "uuid": "^14.0.0",
    "validator": "^13.15.0",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
