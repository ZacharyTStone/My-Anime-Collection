NODE_ENV=development
PORT=5001
MONGO_URL=
JWT_SECRET=
JWT_LIFETIME=7d

# Google SSO — OAuth 2.0 "Web application" Client ID from Google Cloud Console.
# Same value as VITE_GOOGLE_CLIENT_ID on the client. No redirect URIs needed;
# add your origins under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# Groq API key for AI anime recommendations (https://console.groq.com)
GROQ_API_KEY=

# Comma-separated list of allowed frontend origins (required in production)
FRONTEND_URL=
